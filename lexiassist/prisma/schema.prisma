datasource db {
  provider  = "postgresql"
}

generator client {
  provider = "prisma-client-js"
}

enum UserRole {
  CLIENT
  LAWYER
  ADMIN
}

enum CaseStatus {
  TRIAGE
  REVIEW
  MATCHED
  RESOLVED
}

model User {
  id            String          @id @default(uuid())
  email         String          @unique
  password      String?
  name          String?
  role          UserRole        @default(CLIENT)
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  directMessages DirectMessage[]

  // Relations
  lawyerProfile LawyerProfile?
  clientCases    CaseBrief[]    @relation("ClientCases")
  agentSessions  AgentSession[] @relation("ClientSessions")

  // REMOVED @@index([email]): `email String @unique` already creates a
  // unique index on this column automatically.
  @@index([role])
}

model LawyerProfile {
  id             String         @id @default(uuid())
  userId         String         @unique
  user           User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  specialization String[]       
  jurisdiction   String         
  experienceYrs  Int
  isAvailable    Boolean        @default(true)

  // Relations
  assignedCases  CaseBrief[]    @relation("LawyerCases")

  // REMOVED @@index([userId]): Redundant due to @unique constraint.
  @@index([jurisdiction])
  @@index([isAvailable])
}

model CaseBrief {
  id             String         @id @default(uuid())
  clientId       String
  client         User           @relation("ClientCases", fields: [clientId], references: [id])
  lawyerId       String?
  lawyer         LawyerProfile? @relation("LawyerCases", fields: [lawyerId], references: [id])

  title          String
  rawDescription String         @db.Text
  status         CaseStatus     @default(TRIAGE)
  directMessages DirectMessage[]

  // AI Generated Structured Outputs stored safely as JSON
  aiTimeline     Json?
  aiEntities     Json?
  aiRiskAnalysis Json?
  estimatedValue Float?

  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  // Relations
  consultations  Consultation[]
  agentSessions  AgentSession[] @relation("CaseSessions")
  documents       Document[]

  @@index([clientId])
  @@index([lawyerId])
  @@index([status])
  // ADDED: Composite index to optimize the open-case limit queries.
  @@index([clientId, status])
}

model Consultation {
  id           String     @id @default(uuid())
  caseBriefId  String
  caseBrief    CaseBrief  @relation(fields: [caseBriefId], references: [id], onDelete: Cascade)

  webrtcRoomId String     @unique
  scheduledAt  DateTime
  isCompleted  Boolean    @default(false)

  createdAt    DateTime   @default(now())

  @@index([caseBriefId])
  // REMOVED @@index([webrtcRoomId]): Redundant due to @unique constraint.
}

model AgentSession {
  id          String     @id @default(uuid())
  clientId    String
  user        User       @relation("ClientSessions", fields: [clientId], references: [id], onDelete: Cascade)
  caseBriefId String?
  caseBrief   CaseBrief? @relation("CaseSessions", fields: [caseBriefId], references: [id], onDelete: SetNull)
  status      String     @default("PROCESSING")
  content     String?    @db.Text
  metadata    Json?
  messages    Json?

  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  @@index([clientId])
  @@index([status])
  // ADDED: Foreign key index for efficient session-scoped joins.
  @@index([caseBriefId])
}

model Document {
  id            String     @id @default(uuid())
  caseBriefId   String
  caseBrief     CaseBrief  @relation(fields: [caseBriefId], references: [id], onDelete: Cascade)
  fileUrl       String     @unique
  extractedText String     @db.Text
  redlines      Json?
  createdAt     DateTime   @default(now())

  @@index([caseBriefId])
}

model DirectMessage {
  id          String   @id @default(cuid())
  content     String   @db.Text
  createdAt   DateTime @default(now())

  caseBriefId String
  caseBrief   CaseBrief @relation(fields: [caseBriefId], references: [id], onDelete: Cascade)

  senderId    String
  sender      User      @relation(fields: [senderId], references: [id], onDelete: Cascade)

  // Composite index to cover the filter (caseBriefId) and sort (createdAt) 
  // operations in a single index scan for messaging threads.
  @@index([caseBriefId, createdAt])
}